# Copy to .env for local runs. Never commit real values.

# Required — from @BotFather
BOT_TOKEN=123456789:AAExampleTokenFromBotFatherXXXXXXXXXXXXXX

# Required — from https://my.telegram.org (API development tools)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# --- optional: health endpoint & watchdog ---------------------------------
# No HTTP server runs unless a port is provided. On a Render *web service*
# the platform sets PORT, which enables the endpoint automatically; on a
# Background Worker there is nothing to expose.
# HEALTH_PORT=8080
# WATCHDOG_INTERVAL_SECONDS=30
# WATCHDOG_TIMEOUT_SECONDS=20
# WATCHDOG_FATAL_AFTER=5

# --- optional: which plugins register --------------------------------------
# Default: ops,core,filestore,leech,linkshare,moderation,music,postmaker,renamer
# — the shell plus the eight a file bot is used for. ops and core always
# register. Name more (encoder, filters, group, premium, reports, security,
# utilities, welcome) or use * for everything compiled in.
# PLUGINS=encoder,security

# --- optional: voice chat --------------------------------------------------
# A bot token cannot join a group call, so the music player needs its own user
# session. Without it the music plugin registers no commands at all (nothing is
# silently half-working). Generate the string once with telethon and keep it
# secret: it logs in as you.
# SESSION_STRING=

# --- optional: /start picture ----------------------------------------------
# Fetched by Telegram at send time; set to 0/false/off to disable and keep only
# the text. Defaults to https://files.catbox.moe/dhajpx.jpg
# START_IMAGE=https://files.catbox.moe/dhajpx.jpg

# Copy to .env for local runs. Never commit real values.

# Required — from @BotFather
BOT_TOKEN=123456789:AAExampleTokenFromBotFatherXXXXXXXXXXXXXX

# Required — from https://my.telegram.org (API development tools)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# --- optional: health endpoint & watchdog ---------------------------------
# No HTTP server runs unless a port is provided. On a Render *web service*
# the platform sets PORT, which enables the endpoint automatically; on a
# Background Worker there is nothing to expose.
# HEALTH_PORT=8080
# WATCHDOG_INTERVAL_SECONDS=30
# WATCHDOG_TIMEOUT_SECONDS=20
# WATCHDOG_FATAL_AFTER=5

# --- required: PostgreSQL ---------------------------------------------------
# Set this and every store (chats, premium, links, clones, plugin state, users)
# is kept in one `agent_documents` row each instead of JSON files, so two
# instances and a redeploy share the same state. The schema is applied on boot.
# Render's "Postgres" add-on provides this value automatically; a bare
# `postgres://` URL and a `?sslmode=require` suffix are both accepted.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
#
# Every row this bot writes is prefixed with its own scope — `main:<bot id>` for
# the bot, `clone:<bot id>` for a clone — so several bots can share one database
# without overwriting each other's plugin state, premium ledger or chats.
#
# PostgreSQL is always required by the normal runtime. The legacy flag is
# accepted for compatibility, but DB_REQUIRED=0 no longer enables local JSON.
# DB_REQUIRED=1

# --- optional: durable files -----------------------------------------------
# A private channel (the bot must be an admin there) that vault files are
# archived into. With it, a redeploy does not lose the bytes: delivery re-uses
# Telegram's own file_id. Without it, files stay on this host's disk, and a
# container with an ephemeral filesystem loses them.
# STORAGE_CHANNEL=-1001234567890

# --- optional: encryption at rest ------------------------------------------
# Clone tokens are written as ciphertext when this is set (Fernet: AES + HMAC).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, tokens are stored in plaintext (announced in the log at startup).
# Changing it makes existing clone records unreadable: rotate deliberately.
# TOKEN_KEY=

# --- optional: clones ------------------------------------------------------
# How many clones this deployment runs at once. Each clone is a second polling
# client with its own session and data directory, so this is a real ceiling.
# CLONE_LIMIT=5

# --- optional: which plugins register --------------------------------------
# Default optional features: clone,encoder,filestore,leech,linkshare,music,
# postmaker,ai_agent. Mandatory group safety always registers, without slots.
# Add renamer,premium,utilities or use * for everything compiled in.
# PLUGINS=encoder,security

# --- optional: voice chat --------------------------------------------------
# A bot token cannot join a group call, so the music player needs its own user
# session. Without it the music plugin registers no commands at all (nothing is
# silently half-working). Generate the string once with telethon and keep it
# secret: it logs in as you.
# SESSION_STRING=

# --- optional: /start picture ----------------------------------------------
# Fetched by Telegram at send time; set to 0/false/off to disable and keep only
# the text. Defaults to https://files.catbox.moe/dhajpx.jpg
# START_IMAGE=https://files.catbox.moe/dhajpx.jpg

# --- optional: AI Agent /ask -----------------------------------------------
# Explicit questions go to OpenAI; no chat-history ingestion or autonomous tools.
# Both are required. Never inherited by clones. Keep keys secret.
# AI_API_KEY=
# AI_MODEL=

# --- Telegram command registration -----------------------------------------
# Publish only active handler commands at startup and after runtime toggles.
# Telegram may still display its built-in Menu button; no hide API exists.
# SYNC_COMMANDS=1

# Public self-ping, matching a 300-second cadence with a 10-second timeout.
# Render supplies this on web services. Requires PORT/HEALTH_PORT; workers skip it.
# RENDER_EXTERNAL_URL=https://your-service.onrender.com
